.pnp
.pnp.js
dist/
dist-ssr/
build/
out/
.next/
.turbo/
.cache/
coverage/
.vitest/

# --- Python / Backend (apps/core, Python 3.14 via uv) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
htmlcov/

# --- Local STASH_HOME Data, Caches, & Runtime ---
.index/
*.db
*.db-journal
*.db-wal
*.db-shm
.lock
cache/
logs/
*.log
*.jsonl
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Media & Downloaded Test Binaries ---
*.mp4
*.mov
*.avi
*.mkv
*.webm
thumb.jpg
contact.jpg

# --- Benchmark & Run Artifacts ---
results-*.json

# --- Credentials & Environment Variables ---
.env
.env.*
!.env.example
config.toml
!config.example.toml
cookies.txt

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- IDE & Editor Files ---
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Playwright MCP artifacts
.playwright-mcp/
